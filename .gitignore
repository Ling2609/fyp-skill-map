# 26 Oct: coverage data and HTML reports (made by pytest --cov); the text report goes to docs/evidence/quality
.coverage
.coverage.*
htmlcov/

# 28 Oct: Docker. The database dump holds real accounts and their data: never commit it
docker/db/*.dump

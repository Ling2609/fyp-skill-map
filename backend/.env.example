# Copy this file to backend/.env and fill in your own values. Never commit .env (it is in .gitignore).
# Real secrets go only in .env; this example file holds names and placeholders only.

# Required: the API won't start without these two
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>
SECRET_KEY=<long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))">

# Needed for reading skills (projects, modules, job ads) and the AI Assistant
GROQ_API_KEY=<key from console.groq.com>

# Job data (needed to fetch live jobs and format job descriptions)
JSEARCH_KEY=<RapidAPI key for JSearch>
GEMINI_API_KEY=<key>
# GEMINI_MODEL=gemini-3.1-flash-lite

# Sign-in length in minutes (default 30; 480 for a demo or user study)
# ACCESS_TOKEN_EXPIRE_MINUTES=480

# Chat history (defaults shown)
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB=skillmap

# Skill relationship model: folder under backend/ unzipped from the training run; empty = cosine similarity only
# RELATION_MODEL_DIR=data/<model folder>
# RELATION_CUTOFF=0.6

# Forgot-password emails (Gmail needs 2-Step Verification and an app password).
# Without these, the reset code is printed in the backend console instead.
# SMTP_USER=<gmail address>
# SMTP_PASSWORD=<16-character app password>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Connect GitHub: a GitHub OAuth app (README "Connect GitHub"). Without these, students can't connect GitHub,
# so repos can't be shown as theirs and Import from GitHub is off. Callback URL: <FRONTEND_URL>/github/callback
# GITHUB_CLIENT_ID=<Client ID>
# GITHUB_CLIENT_SECRET=<Client secret>
# FRONTEND_URL=http://localhost:5173

# Websites allowed to call the API, comma-separated (default http://localhost:5173)
# CORS_ORIGINS=http://localhost:5173

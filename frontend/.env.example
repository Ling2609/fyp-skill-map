# Copy this file to frontend/.env if you need to change the defaults. Never commit .env.
# Only VITE_ values reach the browser, so never put a secret here.

# Where the API runs (default http://localhost:8000)
# VITE_API_URL=http://localhost:8000

# Email of the career office that runs SkillMap, shown in the privacy notice (default careers@university.example)
# VITE_PRIVACY_CONTACT=careers@your-university.edu.my

# Copy to .env next to docker-compose.prod.yml ON THE SERVER and fill in (never commit the real one; /.env is ignored).
# The server's name: its external IP with dashes + .sslip.io, e.g. for 34.87.12.34 -> 34-87-12-34.sslip.io
SITE=
# A long random password for the server's PostgreSQL (make one: python3 -c "import secrets; print(secrets.token_urlsafe(24))")
POSTGRES_PASSWORD=
# Shown in the privacy notice as the contact address (optional)
PRIVACY_CONTACT=careers@university.example

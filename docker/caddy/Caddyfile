# HTTPS in front of SkillMap (docker-compose.prod.yml). SITE is the server's name, e.g. 34-87-12-34.sslip.io (a free
# name that points at the server's IP address). Caddy gets and renews the Let's Encrypt certificate by itself.
# It sets X-Forwarded-For to the real visitor (and ignores one a visitor sends), which the backend uses for its limits.
{$SITE} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy frontend:80
}
